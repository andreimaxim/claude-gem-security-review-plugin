diff --git a/test/jobs/export_destination_test.rb b/test/jobs/export_destination_test.rb
new file mode 100644
index 0000000..a740624
--- /dev/null
+++ b/test/jobs/export_destination_test.rb
@@ -0,0 +1,15 @@
+require "test_helper"
+
+class ExportDestinationTest < ActiveSupport::TestCase
+  test "destination payloads preserve the legacy client's format" do
+    payload = ActiveJob::Arguments.serialize([ExportDestination.new("archive")]).first
+
+    assert_equal "archive", payload["name"]
+    assert_equal "legacy", payload["format"]
+    assert_equal ExportDestination.new("archive"), ActiveJob::Arguments.deserialize([payload]).first
+
+    current_payload = CurrentDestinationSerializer.instance.serialize(ExportDestination.new("inbox"))
+
+    assert_equal ExportDestination.new("inbox"), ActiveJob::Arguments.deserialize([current_payload]).first
+  end
+end
diff --git a/test/jobs/export_job_test.rb b/test/jobs/export_job_test.rb
new file mode 100644
index 0000000..e70da48
--- /dev/null
+++ b/test/jobs/export_job_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class ExportJobTest < ActiveJob::TestCase
+  def queue_adapter_for_test
+    ActiveJob::QueueAdapters::TestAdapter.new
+  end
+
+  test "export serialization preserves the caller's deadline timezone" do
+    deadline = Time.find_zone!("Asia/Tokyo").local(2020, 1, 1)
+
+    perform_enqueued_jobs do
+      NotebookWorkflows.build_export("zone", amount: BigDecimal("1.25"), deadline: deadline).enqueue
+    end
+
+    assert_equal "2020-01-01T00:00:00+09:00", Note.find_by!("title = ?", "zone").metadata["deadline"]
+  end
+
+  test "unavailable export destinations schedule a retry" do
+    assert_enqueued_with(job: ExportJob) do
+      ExportJob.perform_now("offline")
+    end
+  end
+end
