diff --git a/test/services/notebook_workflows_test.rb b/test/services/notebook_workflows_test.rb
new file mode 100644
index 0000000..a8ad6cf
--- /dev/null
+++ b/test/services/notebook_workflows_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class NotebookWorkflowsTest < ActiveSupport::TestCase
+  setup do
+    Rails.cache.delete_multi(["expired", "retained", "x" * 300 + "/notes/123", "x" * 300 + "/users/123"])
+  end
+
+  teardown do
+    Rails.cache.delete_multi(["expired", "retained", "x" * 300 + "/notes/123", "x" * 300 + "/users/123"])
+  end
+
+  test "timestamp exports contain UTC times in note order" do
+    timestamps = NotebookWorkflows.export_timestamps
+
+    assert_equal [Time.utc(2020, 1, 1, 9), Time.utc(2020, 1, 2, 9), Time.utc(2020, 1, 3, 9)], timestamps
+  end
+
+  test "expiry removes long note export keys but preserves unrelated entries" do
+    key = "x" * 300 + "/notes/123"
+    NotebookWorkflows.cache_export(key, "export")
+    NotebookWorkflows.cache_export("x" * 300 + "/users/123", "profile")
+
+    NotebookWorkflows.expire_note_exports
+
+    assert_nil Rails.cache.read(key)
+    assert_equal "profile", Rails.cache.read("x" * 300 + "/users/123")
+  end
+
+  test "expiry accepts frozen caller keys and preserves other exports" do
+    keys = ["expired"].freeze
+    NotebookWorkflows.cache_export("expired", "old")
+    NotebookWorkflows.cache_export("retained", "new")
+
+    NotebookWorkflows.expire_exports(keys)
+
+    assert_nil Rails.cache.read("expired")
+    assert_equal "new", Rails.cache.read("retained")
+    assert_equal ["expired"], keys
+  end
+
+  test "stream writes retain their bytes when the caller reuses a buffer" do
+    response = ActionDispatch::Response.new
+    buffer = +"é"
+
+    bytes = NotebookWorkflows.write_chunk(response.stream, buffer)
+    buffer.replace("changed")
+
+    assert_equal 2, bytes
+    assert_equal "é", response.body
+  end
+
+  test "quoted SQL booleans retain their meaning in PostgreSQL exports" do
+    connection = Note.connection
+
+    assert_equal true, connection.select_value("SELECT #{NotebookWorkflows.sql_boolean(true)}")
+    assert_equal false, connection.select_value("SELECT #{NotebookWorkflows.sql_boolean(false)}")
+  end
+
+  test "elapsed minutes preserve fractional seconds" do
+    assert_in_delta 1.5083333333333333, NotebookWorkflows.elapsed_minutes(90.5), 0.000001
+  end
+
+  test "deadline advances accept frozen fractional options" do
+    options = { days: 1.5 }.freeze
+
+    deadline = NotebookWorkflows.advance_deadline(Time.utc(2020, 1, 1), options)
+
+    assert_equal Time.utc(2020, 1, 2, 12), deadline
+    assert_equal({ days: 1.5 }, options)
+  end
+
+  test "author names survive filtering of string keyed attributes" do
+    assert_equal "Ada", NotebookWorkflows.author_name({ "name" => "Ada", "role" => "editor" })
+  end
+
+  test "export slugs omit punctuation without inserting separators" do
+    assert_equal "donaldeknuth", NotebookWorkflows.export_slug("Donald E. Knuth")
+  end
+end
+
+class IsolatedExportTest < ActiveSupport::TestCase
+  # The workflow starts its own isolation transaction, outside fixture transactions.
+  self.use_transactional_tests = false
+
+  test "nested export reads use the same isolation" do
+    assert_equal 3, NotebookWorkflows.isolated_export(Note.connection)
+  end
+end
