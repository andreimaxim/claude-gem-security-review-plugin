#!/usr/bin/env bash
# Prepare the SQLite-only notebook app on a fresh or restored Linux orb.
set -euo pipefail
cd "$(dirname "$0")/.."

echo '== System dependencies =='
packages=(build-essential libssl-dev libyaml-dev zlib1g-dev libffi-dev libreadline-dev libsqlite3-dev sqlite3 curl ca-certificates)
missing=()
for package in "${packages[@]}"; do
  dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed' || missing+=("$package")
done
if ((${#missing[@]})); then
  root=()
  if [[ $(id -u) != 0 ]]; then root=(sudo -E); fi
  "${root[@]}" apt-get update -qq
  "${root[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}"
fi

echo '== Installing mise and Ruby =='
if [[ ! -x "$HOME/.local/bin/mise" ]]; then
  curl --fail --silent --show-error --location https://mise.run | sh
fi
export PATH="$HOME/.local/bin:$PATH"
mise trust "$PWD/mise.toml"
mise install
mise reshim
activation='export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"'
for profile in "$HOME/.bashrc" "$HOME/.bash_profile"; do
  grep -Fqx "$activation" "$profile" 2>/dev/null || printf '\n%s\n' "$activation" >> "$profile"
done

echo '== Installing locked gems and preparing SQLite =='
export BUNDLE_FROZEN=true
mise exec -- bundle install
mise exec -- bin/rails db:prepare
